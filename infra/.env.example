# Copy this file to .env and fill in values for the target Azure environment.
# Never commit secrets or real environment-specific credentials here.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_APP_OBJECT_ID=
AZURE_SERVICE_PRINCIPAL_OBJECT_ID=

AZURE_LOCATION=southafricanorth
AZURE_DEPLOYMENT_ENVIRONMENT=dev
AZURE_RESOURCE_GROUP=rg-tco
AZURE_NAME_PREFIX=tcocalculator
# Cost target only; Azure budgets alert but do not stop resources.
AZURE_MONTHLY_BUDGET_USD=100
AZURE_BUDGET_NAME=rg-tco-monthly

GITHUB_REPOSITORY=threadkeeper/tco-calculator

# Container Apps authentication registration. GitHub-to-Azure deployment uses
# OIDC and must not use a stored Azure client secret.
ENTRA_CLIENT_ID=
# Versioned Azure Key Vault secret URI; do not place the secret value here.
ENTRA_CLIENT_SECRET_URI=

# One-shot migration inputs for infra/Set-EntraClientSecret.ps1. The script
# removes both fields after a successful write. Never commit populated values.
APP_SECRET_ID=
APP_SECRET_VALUE=

# Reviewed official build and runtime images pinned by sha256 digest.
WEB_BUILD_IMAGE=
RUST_BUILD_IMAGE=
RUNTIME_IMAGE=

# Immutable SHA-tagged ACR image reference used by Bicep.
CONTAINER_IMAGE=

# Populated by infra/getkeys.ps1 after foundation deployment.
AZURE_CONTAINER_APPS_ENVIRONMENT_ID=
AZURE_CONTAINER_APPS_ENVIRONMENT_NAME=
AZURE_CONTAINER_REGISTRY=
AZURE_CONTAINER_REGISTRY_ID=
AZURE_CONTAINER_REGISTRY_NAME=
AZURE_COSMOS_ACCOUNT_ID=
AZURE_COSMOS_ACCOUNT_NAME=
AZURE_COSMOS_PRIVATE_ENDPOINT_ID=
AZURE_COSMOS_PRIVATE_DNS_ZONE_ID=
AZURE_FOUNDRY_ACCOUNT_ID=
AZURE_FOUNDRY_ACCOUNT_NAME=
AZURE_FOUNDRY_PRIVATE_ENDPOINT_ID=
AZURE_FOUNDRY_PRIVATE_DNS_ZONE_ID=
AZURE_VIRTUAL_NETWORK_ID=
AZURE_CONTAINER_APPS_SUBNET_ID=
AZURE_PRIVATE_ENDPOINT_SUBNET_ID=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=
COSMOSDB_ENDPOINT=
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=

# Populated after the separate application deployment.
AZURE_CONTAINER_APP_ID=
AZURE_CONTAINER_APP_NAME=
AZURE_CONTAINER_APP_FQDN=
AZURE_CONTAINER_APP_PRINCIPAL_ID=