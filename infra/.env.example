# Copy this file to .env and fill in values for the target Azure environment.
# Never commit secrets or real environment-specific credentials here.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_APP_OBJECT_ID=
AZURE_SERVICE_PRINCIPAL_OBJECT_ID=

AZURE_LOCATION=southafricanorth
AZURE_DEPLOYMENT_ENVIRONMENT=dev
AZURE_RESOURCE_GROUP=rg-tco
AZURE_NAME_PREFIX=tcocalculator
# Cost target only; Azure budgets alert but do not stop resources.
AZURE_MONTHLY_BUDGET_USD=100
AZURE_BUDGET_NAME=rg-tco-monthly

GITHUB_REPOSITORY=threadkeeper/tco-calculator

# Container Apps authentication registration. GitHub-to-Azure deployment uses
# OIDC and must not use a stored Azure client secret.
ENTRA_CLIENT_ID=
# Versioned Azure Key Vault secret URI; do not place the secret value here.
ENTRA_CLIENT_SECRET_URI=

# Immutable SHA-tagged ACR image reference used by Bicep.
CONTAINER_IMAGE=